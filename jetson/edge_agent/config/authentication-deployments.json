          "image": "47.109.49.98:30881/uav-mvp/crypto-service@sha256:88ee9c82cf30fcb4e2d92958cc859164e3cd90b9c0712cc7fbf27cc2ee5fec63",
          "imagePullPolicy": "Never",
          "livenessProbe": {
            "failureThreshold": 3,
            "httpGet": {
              "path": "/health",
              "port": 8080,
              "scheme": "HTTP"
            },
            "initialDelaySeconds": 10,
            "periodSeconds": 15,
            "successThreshold": 1,
            "timeoutSeconds": 1
          },
          "name": "auth",
          "ports": [
            {
              "containerPort": 8080,
              "protocol": "TCP"
            }
          ],
          "readinessProbe": {
            "exec": {
              "command": [
                "python",
